-- Deteksi Chat untuk Autoruin
game:GetService("TextChatService").OnIncomingMessage = function(message)
    if not isAutoRuin then return end
    local txt = message.Text:lower()
    
    if txt:find("%[server%]:") and txt:find("ancient ruin has started") then
        task.spawn(function()
            local targetRuin = CFrame.new(6095.5918, -585.924316, 4634.07373, -0.656337857, -3.71952815e-08, 0.75446713, 7.69708386e-09, 1, 5.59960363e-08, -0.75446713, 4.25595132e-08, -0.656337857)
            local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                local saved = hrp.CFrame
                task.wait(1) 
                hrp.CFrame = targetRuin
                
                -- Jeda 30 Menit (1800 detik)
                for i = 1800, 1, -1 do 
                    if not isAutoRuin then break end 
                    task.wait(1) 
                end
                
                -- Balik lagi jika Autoruin masih aktif
                if hrp and isAutoRuin then 
                    hrp.CFrame = saved 
                end
            end
        end)
    end
end

