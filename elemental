-- Helper Functions
local function getRandomCFrame(cframeTable)
    return cframeTable[math.random(1, #cframeTable)]
end

local function teleportTo(cframe)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if hrp then hrp.CFrame = cframe end
end

local function saveCurrentLocation()
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then savedLocation = hrp.CFrame end
end

-- Menghitung Waktu Berjalan Untuk AUTO (58 menit per lokasi: Runic & Game)
local function getAutoTargetArea()
    local t = os.date("*t")
    local h, m = t.hour, t.min
    local elapsedMinutes = 0
    local foundLastEvent = false
    
    for offset = 0, 3 do
        local checkHour = h - offset
        if checkHour < 0 then checkHour = checkHour + 24 end
        if endHours[checkHour] then
            elapsedMinutes = (offset * 60) + m
            foundLastEvent = true
            break
        end
    end

    if foundLastEvent then
        if elapsedMinutes >= 2 and elapsedMinutes < 60 then
            return "Runic"
        elseif elapsedMinutes >= 60 and elapsedMinutes < 118 then
            return "Game"
        end
    end
    
    return nil 
end

-- Teleport ke Event dengan Sistem Tunggu, Radius 3 Studs, dan Re-Check
local function executePocongTeleport()
    task.wait(10)
    
    local targetPlayer = Players:FindFirstChild("pociclone")
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local pociCFrame = targetPlayer.Character.HumanoidRootPart.CFrame
        local pociPos = pociCFrame.Position
        local targetCFrame = pociCFrame 

        if (pociPos - eventMainLocations.Volcano.Position).Magnitude <= 3 then
            targetCFrame = getRandomCFrame(eventSubLocations.Volcano)
        elseif (pociPos - eventMainLocations.Storm.Position).Magnitude <= 3 then
            targetCFrame = getRandomCFrame(eventSubLocations.Storm)
        elseif (pociPos - eventMainLocations.Blizzard.Position).Magnitude <= 3 then
            targetCFrame = getRandomCFrame(eventSubLocations.Blizzard)
        end

        teleportTo(targetCFrame)
    end

    task.wait(60)

    local targetPlayer2 = Players:FindFirstChild("pociclone")
    if targetPlayer2 and targetPlayer2.Character and targetPlayer2.Character:FindFirstChild("HumanoidRootPart") then
        local pociCFrame2 = targetPlayer2.Character.HumanoidRootPart.CFrame
        local pociPos2 = pociCFrame2.Position
        local targetCFrame2 = pociCFrame2 

        if (pociPos2 - eventMainLocations.Volcano.Position).Magnitude <= 3 then
            targetCFrame2 = getRandomCFrame(eventSubLocations.Volcano)
        elseif (pociPos2 - eventMainLocations.Storm.Position).Magnitude <= 3 then
            targetCFrame2 = getRandomCFrame(eventSubLocations.Storm)
        elseif (pociPos2 - eventMainLocations.Blizzard.Position).Magnitude <= 3 then
            targetCFrame2 = getRandomCFrame(eventSubLocations.Blizzard)
        end

        teleportTo(targetCFrame2)
    end
end

