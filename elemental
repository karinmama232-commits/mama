-- Logika Elemental Event (Jam & Teleport Target)
BtnElementalEvent.MouseButton1Click:Connect(function()
    isElementalEvent = not isElementalEvent
    BtnElementalEvent.BackgroundTransparency = isElementalEvent and 0 or 0.4
    
    if not isElementalEvent then
        isLucidPaused = false -- Unpause Lucid jika tombol Elemental Event dimatikan
    end
    
    if isElementalEvent then
        task.spawn(function()
            local startHours = { [2]=true, [5]=true, [8]=true, [11]=true, [14]=true, [17]=true, [20]=true, [23]=true }
            local endHours   = { [3]=true, [6]=true, [9]=true, [12]=true, [15]=true, [18]=true, [21]=true, [0]=true }
            
            local savedCFrame = nil
            local isTeleportedToPocong = false
            
            while isElementalEvent do
                local dateTable = os.date("*t")
                local currentHour = dateTable.hour
                local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                
                -- Cek apakah jam event dimulai
                if startHours[currentHour] and not isTeleportedToPocong then
                    isLucidPaused = true -- Beri sinyal jeda ke Lucid
                    
                    if hrp then
                        savedCFrame = hrp.CFrame
                    end
                    
                    local targetPlayer = Players:FindFirstChild("ini_pocong")
                    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        if hrp then
                            hrp.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
                            isTeleportedToPocong = true
                        end
                    end
                -- Cek apakah jam event selesai
                elseif endHours[currentHour] and isTeleportedToPocong then
                    if hrp and savedCFrame then
                        hrp.CFrame = savedCFrame
                    end
                    isTeleportedToPocong = false
                    savedCFrame = nil
                    
                    isLucidPaused = false -- Beri sinyal lanjut ke Lucid
                end
                
                task.wait(5)
            end
        end)
    end
end)
