-- ==========================================
local BtnElementalEvent = Instance.new("TextButton", MainFrame)
BtnElementalEvent.Size = UDim2.new(0, 200, 0, 28)
BtnElementalEvent.Position = UDim2.new(0, 10, 0, 80)
BtnElementalEvent.Text = "ELEMENTAL EVENT"
styleBtn(BtnElementalEvent, 9)

BtnElementalEvent.MouseButton1Click:Connect(function()
    isElementalEvent = not isElementalEvent
    BtnElementalEvent.BackgroundTransparency = isElementalEvent and 0 or 0.4
    
    if isElementalEvent then
        task.spawn(function()
            local startHours = { [2]=true, [5]=true, [8]=true, [11]=true, [14]=true, [17]=true, [20]=true, [23]=true }
            local endHours   = { [3]=true, [6]=true, [9]=true, [12]=true, [15]=true, [18]=true, [21]=true, [0]=true }
            
            local lastHandledHour = -1
            
            -- Pengecekan Awal Saat Tombol Aktif
            local currentHour = os.date("*t").hour
            if startHours[currentHour] then
                saveCurrentLocation()
                teleportToPocong()
                lastHandledHour = currentHour
            else
                -- Jika bukan jam event saat tombol dinyalakan, diam saja dan simpan jam sekarang
                lastHandledHour = currentHour
            end
            
            -- Loop Otomatis Berdasarkan Jam Server
            while isElementalEvent do
                local dateTable = os.date("*t")
                local hour = dateTable.hour
                
                if hour ~= lastHandledHour then
                    if startHours[hour] then
                        saveCurrentLocation()
                        teleportToPocong()
                        lastHandledHour = hour
                    elseif endHours[hour] then
                        teleportToSelectedHydra()
                        lastHandledHour = hour
                    end
                end
                
                task.wait(3)
            end
        end)
    end
end)
