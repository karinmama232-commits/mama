-- Helper Functions
local function repeatActionForDuration(duration, actionFunc)
    local startTime = tick()
    while tick() - startTime < duration do
        pcall(actionFunc)
        task.wait(0.1)
    end
end

local function equipRod()
    repeatActionForDuration(2, function()
        RE_Equip:FireServer(1)
    end)
end

local function unequipRod()
    repeatActionForDuration(2, function()
        RE_Unequip:FireServer()
    end)
end

local function getRandomCFrame(cframeTable)
    return cframeTable[math.random(1, #cframeTable)]
end

local function teleportTo(cframe)
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = cframe
    end
end

