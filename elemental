-- Logika PET (Dengan Jeda 3 Detik Setiap Tahap & Remote Terbaru)
BtnPet.MouseButton1Click:Connect(function()
    isPet = not isPet
    BtnPet.BackgroundTransparency = isPet and 0 or 0.4
    
    if isPet then
        task.spawn(function()
            while isPet do
                local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then break end
                
                -- 1. Simpan posisi awal & Jeda 3s
                local startCFrame = hrp.CFrame
                task.wait(3)
                
                -- 2. Teleport ke Ular & Jeda 3s
                hrp.CFrame = snakeCFrame
                task.wait(3)
                
                -- 3. Pasang Pet Stay & Jeda 3s
                pcall(function()
                    RF_Pet:InvokeServer({["Action"] = "Stay"})
                end)
                task.wait(3)
                
                -- 4. Teleport balik ke posisi awal & Jeda 3s
                local currentHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if currentHrp then currentHrp.CFrame = startCFrame end
                task.wait(3)
                
                -- 5. Buka pancing & Jeda 3s
                equipRod()
                task.wait(3)
                
                -- 6. Loop mancing berjalan (Remote & Parameter Terbaru)
                local fishingLoopActive = true
                task.spawn(function()
                    while isPet and fishingLoopActive do
                        pcall(function()
                            RF_Fish1:InvokeServer()
                            task.wait(0.01)
                            RF_Fish2:InvokeServer(-1.233184814453125, 0.5974168063934951, 1788506749.784816)
                            task.wait(0.08)
                            RE_Catch:FireServer()
                        end)
                        task.wait(0.05)
                    end
                end)
                
                -- 7. Jeda 100 menit (6000 detik)
                for i = 6000, 1, -1 do
                    if not isPet then break end
                    task.wait(1)
                end
                
                -- Stop loop mancing
                fishingLoopActive = false
                task.wait(1)
                
                -- 8. Tutup pancing & Jeda 3s
                unequipRod()
                task.wait(3)
                
                -- 9. Simpan posisi terbaru & Jeda 3s
                currentHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if currentHrp then
                    local lastCFrame = currentHrp.CFrame
                    task.wait(3)
                    
                    -- 10. Teleport ke Ular & Jeda 3s
                    currentHrp.CFrame = snakeCFrame
                    task.wait(3)
                    
                    -- 11. Ambil Pet (Follow) & Jeda 3s
                    pcall(function()
                        RF_Pet:InvokeServer({["Action"] = "Follow"})
                    end)
                    task.wait(3)
                    
                    -- 12. Teleport balik ke posisi terbaru & Jeda 3s
                    if isPet then
                        currentHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                        if currentHrp then currentHrp.CFrame = lastCFrame end
                        task.wait(3)
                    end
                end
            end
        end)
    else
        -- Jika Tombol PET dimatikan (OFF)
        task.spawn(function()
            unequipRod()
            task.wait(3)
            
            local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local savedCFrame = hrp.CFrame
                task.wait(3)
                
                hrp.CFrame = snakeCFrame
                task.wait(3)
                
                pcall(function()
                    RF_Pet:InvokeServer({["Action"] = "Follow"})
                end)
                task.wait(3)
                
                local currentHrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if currentHrp then
                    currentHrp.CFrame = savedCFrame
                end
            end
        end)
    end
end)

