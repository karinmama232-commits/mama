-- Variable Penyimpan CFrame Posisi & Rotasi Awal
local savedLocation = nil

-- Helper Functions
local function getRandomCFrame(cframeTable)
    return cframeTable[math.random(1, #cframeTable)]
end

local function teleportTo(cframe)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if hrp then
        hrp.CFrame = cframe
    end
end

-- Simpan CFrame Awal (Termasuk Orientasi/Sudut Hadap)
local function saveCurrentLocation()
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if hrp then
        savedLocation = hrp.CFrame
    end
end

local function teleportToPocong()
    local targetPlayer = Players:FindFirstChild("Rionn603")
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local char = Player.Character or Player.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame
        end
    end
end

-- Fungsi Menentukan Lokasi Teleport Saat Selesai Event
local function teleportToSelectedHydra()
    if savedLocation then
        teleportTo(savedLocation)
        savedLocation = nil
    else
        if isBlizzardSelected then
            teleportTo(getRandomCFrame(blizzardCFrames))
        elseif isStormSelected then
            teleportTo(getRandomCFrame(stormCFrames))
        elseif isVolcanoSelected then
            teleportTo(getRandomCFrame(volcanoCFrames))
        else
            teleportTo(getRandomCFrame(allHydraCFrames))
        end
    end
end

