                    if targetArea == "Tribunal" then teleportTo(getRandomCFrame(tribunalCFrames))
                    elseif targetArea == "Core" then teleportTo(getRandomCFrame(coreCFrames))
                    end
                    lastTeleportedArea = targetArea
                elseif targetArea == nil then
                    lastTeleportedArea = nil
                end
                task.wait(3)
            end
        end)
    end
end)

