-- Logika LUCID
BtnLucid.MouseButton1Click:Connect(function()
    isLucid = not isLucid
    BtnLucid.BackgroundTransparency = isLucid and 0 or 0.4
    
    if isLucid then
        task.spawn(function()
            local RE_Lucid = Net:WaitForChild("RE/992cb93cea8a815ac6db86be739bf6c2dc77c159266ed766c4a036c8144acea9")
            
            local underwaterCFrames = {
                CFrame.new(-3140.12207, -643.476807, -10412.6221, 0.042624779, 6.91801105e-08, -0.999091148, -8.82980515e-08, 1, 6.54759305e-08, 0.999091148, 8.54269047e-08, 0.042624779),
                CFrame.new(-3139.31689, -643.262024, -10439.7197, 0.00107784977, 1.20874724e-08, -0.999999404, -2.67054379e-08, 1, 1.20586945e-08, 0.999999404, 2.66924243e-08, 0.00107784977),
                CFrame.new(-3139.00146, -643.476807, -10457.4102, 0.709533572, 4.93398566e-08, -0.704671621, 1.01340314e-08, 1, 8.0222172e-08, 0.704671621, -6.40614886e-08, 0.709533572)
            }
            
            while isLucid do
                -- Hanya pause jika tombol Elemental Event AKTIF dan status Pause terdeteksi True
                while isElementalEvent and isLucidPaused and isLucid do
                    task.wait(1)
                end
                
                if not isLucid then break end

                -- 1. Fire Remote Lucid
                pcall(function()
                    RE_Lucid:FireServer("Lucid", 1, 1)
                end)
                task.wait(1)
                
                -- 2. Teleport ke salah satu CFrame secara acak (jika tidak sedang di-pause oleh event)
                local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if hrp and not (isElementalEvent and isLucidPaused) then
                    local randomTarget = underwaterCFrames[math.random(1, #underwaterCFrames)]
                    hrp.CFrame = randomTarget
                end
                
                -- 3. Deteksi Chat Log berdasarkan Display Name Player
                local gotStone = false
                local conn
                
                local TextChatService = game:GetService("TextChatService")
                if TextChatService and TextChatService:FindFirstChild("TextChannels") then
                    local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                    if generalChannel then
                        conn = generalChannel.MessageReceived:Connect(function(message)
                            if message and message.Text then
                                local expectedText = Player.DisplayName .. " obtained a Runic Enchant Stone with a 1 in 1M chance!"
                                if string.find(message.Text, expectedText) then
                                    gotStone = true
                                end
                            end
                        end)
                    end
                end
                
                -- Polling tunggu pesan di-chat muncul atau terjedanya event (hanya jika tombol event aktif)
                repeat
                    task.wait(1)
                until gotStone or not isLucid or (isElementalEvent and isLucidPaused)
                
                if conn then conn:Disconnect() end
                task.wait(1)
            end
        end)
    end
end)

