-- [[ CHAT MONITORING & CLAIM SYSTEM ]] --
local TextChatService = game:GetService("TextChatService")
local channel = TextChatService:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:FindFirstChild("RBXGeneral")

if channel then
    channel.MessageReceived:Connect(function(message)
        local rawText = message.Text
        local txt = rawText:lower()
        local senderName = message.TextSource and game.Players:GetPlayerByUserId(message.TextSource.UserId) and game.Players:GetPlayerByUserId(message.TextSource.UserId).Name or "Unknown Player"

        -- 1. DETECT !CLAIM COMMAND
        if txt:find("!claim") then
            local claimedTotal = totalCatches.total

            sendWebhookPayload(
                "Evo Claimed Successfully!",
                "All accumulated Evolved Enchant Stone have been claimed by **" .. senderName .. "**!\n" ..
                "Total Claimed: **" .. claimedTotal .. " Evo**",
                65280, -- Green
                "Counter has been reset to 0"
            )

            -- Reset Accumulated Totals
            totalCatches.total = 0
            totalCatches.players = {}
            totalCatches.playerOrder = {}
            return
        end

        -- 2. DETECT EVOLVED ENCHANT STONE CATCH LOGS
        if txt:find("obtained") and txt:find(TARGET_ITEM_LOWER) then
            local cleanerText = rawText:gsub("<[^>]*>", "")
            local luckyPlayer = cleanerText:match("^(.-) obtained") or "Unknown Player"

            -- Start timer & detect server on first catch of the batch
            if batchBuffer.count == 0 then
                batchBuffer.startTime = os.time()
                batchBuffer.server = detectServer(luckyPlayer)
            elseif batchBuffer.server == "Unknown" then
                batchBuffer.server = detectServer(luckyPlayer)
            end

            -- Add to Batch Buffer
            batchBuffer.count = batchBuffer.count + 1
            if not batchBuffer.players[luckyPlayer] then
                batchBuffer.players[luckyPlayer] = 0
                table.insert(batchBuffer.playerOrder, luckyPlayer)
            end
            batchBuffer.players[luckyPlayer] = batchBuffer.players[luckyPlayer] + 1

            -- Add to Lifetime Accumulated Total
            totalCatches.total = totalCatches.total + 1
            if not totalCatches.players[luckyPlayer] then
                totalCatches.players[luckyPlayer] = 0
                table.insert(totalCatches.playerOrder, luckyPlayer)
            end
            totalCatches.players[luckyPlayer] = totalCatches.players[luckyPlayer] + 1

            -- Trigger Webhook when reaching 10 catches
            if batchBuffer.count >= BATCH_SIZE then
                sendBatchSummary()
            end
        end
    end)
end
