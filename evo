-- [[ HELPER FUNCTIONS ]] --
local function sendWebhookPayload(embedTitle, descriptionText, embedColor, footerText)
    local req = request or http_request or (http and http.request)
    if not req then return end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["embeds"] = {{
                ["title"] = embedTitle,
                ["description"] = descriptionText,
                ["color"] = embedColor,
                ["footer"] = {
                    ["text"] = footerText
                }
            }}
        })
    })
end

local function detectServer(playerName)
    if not playerName then return "Unknown" end
    return serverMap[playerName:lower()] or "Unknown"
end

local function formatDuration(seconds)
    if seconds < 60 then
        return string.format("%d detik", seconds)
    end
    local mins = math.floor(seconds / 60)
    local secs = seconds % 60
    if secs > 0 then
        return string.format("%d menit %d detik", mins, secs)
    else
        return string.format("%d menit", mins)
    end
end

local function getTotalEvoString()
    if totalCatches.total == 0 then
        return "Total Evo: 0"
    end

    local lines = { "Total Evo: " .. totalCatches.total }
    for _, player in ipairs(totalCatches.playerOrder) do
        local count = totalCatches.players[player]
        if count and count > 0 then
            table.insert(lines, string.format("%d %s", count, player))
        end
    end

    return table.concat(lines, "\n")
end

-- [[ BATCH SUMMARY FUNCTION ]] --
local function sendBatchSummary()
    local elapsedSeconds = batchBuffer.startTime and (os.time() - batchBuffer.startTime) or 0
    local durationStr = formatDuration(elapsedSeconds)

    local footerStr = "Event Session: " .. durationStr .. "\n" ..
                      getTotalEvoString() .. "\n" ..
                      "Type **!claim** in chat to collect evo"

    local playerListStr = table.concat(batchBuffer.playerOrder, ", ")

    local title = "Evolved Enchant Stone Has Concluded!"
    local description = "**Server: " .. batchBuffer.server .. "**\n" ..
                        "Caught " .. batchBuffer.count .. " Evo\n" ..
                        "(" .. playerListStr .. ")"
    local color = 10181046 -- Purple

    sendWebhookPayload(title, description, color, footerStr)

    -- Reset Batch Buffer Only
    batchBuffer.count = 0
    batchBuffer.players = {}
    batchBuffer.playerOrder = {}
    batchBuffer.server = "Unknown"
    batchBuffer.startTime = nil
end

