-- Core Fungsi Ganti Rod (Tutup -> Cek Ruin -> Eksekusi 4 Pasang + Jeda 0.5s -> Buka)
local function processGantiRod()
    executeSafely(function()
        closeRod()
        task.wait(1)
        
        local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        local inRuin = false
        if hrp then
            local ruinTargetPos = Vector3.new(6045.40186, -588.601013, 4608.93799)
            local distToRuin = (hrp.Position - ruinTargetPos).Magnitude
            if distToRuin < 50 then
                inRuin = true
            end
        end
        
        if inRuin then
            equipGosfinAll()
        else
            equipElementRodAll()
        end
        task.wait(1.5)
        
        openRod()
    end)
end

