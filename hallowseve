-- Helper Routine Mesin
local function runMesinRoutine()
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local RE_FishToggle = Net:WaitForChild("RE/5302d60da4609e2b0fe4bb8395344962c66affb5106215c264313ba195278fc4")
        
        -- Stop mancing
        stopFishing(RE_FishToggle)
        task.wait(3)
        
        local saved = hrp.CFrame
        task.wait(0.5)
        
        -- Teleport ke lokasi mesin
        hrp.CFrame = CFrame.new(541.777344, 1899.38269, -5636.19141, -0.999005139, 7.20814208e-09, 0.0445950069, 6.24161789e-09, 1, -2.18126104e-08, -0.0445950069, -2.1512566e-08, -0.999005139)
        task.wait(1.5)
        
        -- Tutup pancing
        closeRod()
        task.wait(1)
        
        -- Fragment 1 (Biru)
        openFragment1()
        interactForDuration(3)
        task.wait(1)
        closeFragment1()
        task.wait(1)
        
        -- Fragment 2 (Kuning)
        openFragment2()
        interactForDuration(4)
        task.wait(1)
        closeFragment2()
        task.wait(1)
        
        -- Fragment 3 (Ungu)
        openFragment3()
        interactForDuration(5)
        task.wait(1)
        closeFragment3()
        task.wait(1)
        
        -- Buka pancing kembali
        openRod()
        task.wait(1)
        
        -- Balik ke tempat save
        if hrp then hrp.CFrame = saved end
        task.wait(1)
        
        -- Auto mancing
        startFishing(RE_FishToggle)
        task.wait(3)
    end
end

