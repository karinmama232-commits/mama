local function executeSafely(routineFunc)
    while isRoutineRunning do
        task.wait(2)
    end
    isRoutineRunning = true
    local success, err = pcall(routineFunc)
    isRoutineRunning = false
    if not success then
        warn("Routine Error: ", err)
    end
end

