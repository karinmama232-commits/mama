if channel then
    channel.MessageReceived:Connect(function(message)
        local txt = message.Text:lower()
        
        if txt:find("obtained") then
            for _, weight in pairs(maxton_weights) do
                if txt:find(weight:lower()) then
                    local cleanerText = message.Text:gsub("<[^>]*>", "")
                    local luckyPlayer = cleanerText:match("^(.-) obtained") or "Unknown Player"
                    local fishName = cleanerText:match("obtained a (.-) %(" .. weight .. "%)") or "Unknown Fish"
                    sendWebhookMaxton(fishName .. " (" .. weight .. ")", message.Text, luckyPlayer, false)
                    return
                end
            end
        end
    end)
end
