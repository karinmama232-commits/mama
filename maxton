-- [[ FUNGSI KIRIM WEBHOOK ]] --
local function sendWebhookMaxton(fishName, fullText, luckyPlayer, isStart)
    local req = request or http_request or (http and http.request)
    if not req then return end

    local content, description, color
    
    if isStart then
        content = "Webhook Maxton Aktif!"
        description = "Script running di akun: **" .. game.Players.LocalPlayer.Name .. "**\nMenunggu kabar dari server..."
        color = 65535 
    else
        -- Update Counter Player
        playerCount[luckyPlayer] = playerCount[luckyPlayer] or {maxton=0}
        playerCount[luckyPlayer].maxton = playerCount[luckyPlayer].maxton + 1

        local s = os.time() - startTime
        local runtime = string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)

        -- Content sesuai format yang diminta
        content = "Congratulations!! **" .. luckyPlayer .. "** You have obtained a new **Maxton** Fish!"

        local playerStats = "Player " .. luckyPlayer .. "\nMenangkap " .. fishName .. " Maxton"

        -- Build Server Records string
        local serverStats = {}
        for p, data in pairs(playerCount) do
            table.insert(serverStats, p .. ": " .. data.maxton .. " Maxton")
        end
        local serverStatsStr = table.concat(serverStats, " | ")

        description = "**" .. fullText .. "**\n\n**Script Runtime:** " .. runtime ..
            "\n\n" .. playerStats ..
            "\n\n**Server Records**\n" .. serverStatsStr

        color = 16711680 -- Merah khusus Maxton
    end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["content"] = content,
            ["embeds"] = {{
                ["description"] = description,
                ["color"] = color,
                ["footer"] = {["text"] = "Server Mybubub • " .. os.date("%X")}
            }}
        })
    })
end

