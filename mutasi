-- [[ FUNGSI KIRIM WEBHOOK ]] --
local function sendWebhook(fishName, fullText, category, isStart)
    local req = request or http_request or (http and http.request)
    if not req then return end

    local content, description, color
    
    if isStart then
        content = "🔔 **Webhook Fishit Aktif!**"
        description = "Script running di akun: **" .. game.Players.LocalPlayer.Name .. "**\nMenunggu kabar dari server..."
        color = 65535 
    else
        local cleanerText = fullText:gsub("<[^>]*>", "") 
        local luckyPlayer = cleanerText:match("%[Server%]%: (.-) obtained") or "Unknown Player"

        -- Update Counter Server
        serverCount[category] = (serverCount[category] or 0) + 1

        -- Update Counter Player
        playerCount[luckyPlayer] = playerCount[luckyPlayer] or {}
        playerCount[luckyPlayer][category] = (playerCount[luckyPlayer][category] or 0) + 1

        local s = os.time() - startTime
        local runtime = string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)

        -- ambil nama ikan + berat langsung dari pesan server
        local fishFullWithWeight = cleanerText:match("obtained (.-)$") or fishName or category

        content = "Congratulations!! **" .. luckyPlayer .. "** You have obtained a new **" .. fishFullWithWeight .. "** Fish!"

        -- Player Records singkat
        local pStats = playerCount[luckyPlayer][category]
        local playerStats = "Player " .. luckyPlayer .. "\nSudah Menangkap " .. pStats .. " " .. category:gsub("^%l", string.upper)

        -- Server Records dinamis (hanya tampilkan yang >0)
        local serverStats = {}
        for k,v in pairs(serverCount) do
            if v > 0 then
                table.insert(serverStats, k:gsub("^%l", string.upper) .. ": " .. v)
            end
        end
        local serverStatsText = table.concat(serverStats, " | ")

        description = "**" .. cleanerText .. "**\n\n**Script Runtime:** " .. runtime ..
            "\n\n" .. playerStats ..
            "\n\n**Server Records**\n" .. serverStatsText

        -- Warna embed sesuai mutasi
        color = colorMap[category] or 8421504
    end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["content"] = content,
            ["embeds"] = {{
                ["description"] = description,
                ["color"] = color,
                ["footer"] = {["text"] = "Server Mybubub • " .. os.date("%X", os.time() - 3600)}
            }}
        })
    })
end

-- [[ STARTUP ]] --
sendWebhook(nil, nil, nil, true)

-- [[ DETEKSI CHAT ]] --
game:GetService("TextChatService").OnIncomingMessage = function(message)
    local txt = message.Text:lower()
    
    if txt:find("%[server%]:") and txt:find("obtained") then
        for category, list in pairs(list_mutasi) do
            for _, n in pairs(list) do
                -- logika sama seperti Evo: asal ada kata kunci mutasi di teks, langsung match
                if string.find(txt, n:lower(), 1, true) then
                    sendWebhook(n, message.Text, category, false)
                    return
                end
            end
        end
    end
end
