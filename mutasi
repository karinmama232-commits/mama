-- [[ FUNGSI KIRIM WEBHOOK ]] --
local function sendWebhook(mutationName, fullText, isStart)
    local req = request or http_request or (http and http.request)
    if not req then return end

    local content, description, color
    
    if isStart then
        content = "🔔 **Webhook Fishit Aktif!**"
        description = "Script running di akun: **" .. game.Players.LocalPlayer.Name .. "**\nMenunggu kabar dari server..."
        color = 65535 
    else
        local cleanerText = fullText:gsub("<[^>]*>", "") 
        local luckyPlayer = cleanerText:match("^(.-) obtained") or "Unknown Player"

        -- Update Counter Server
        serverCount[mutationName] = (serverCount[mutationName] or 0) + 1

        -- Update Counter Player
        playerCount[luckyPlayer] = playerCount[luckyPlayer] or {}
        playerCount[luckyPlayer][mutationName] = (playerCount[luckyPlayer][mutationName] or 0) + 1

        local s = os.time() - startTime
        local runtime = string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)

        -- Notif utama → pakai mutation
        content = "Congratulations!! **" .. luckyPlayer .. "** You have obtained a new **" .. mutationName .. " mutation!**"

        local pStats = playerCount[luckyPlayer][mutationName]
        local playerStats = "Player " .. luckyPlayer .. "\nSudah Mendapatkan " .. pStats .. " " .. mutationName

        -- Player Records dinamis
        local playerRecords = {}
        for mut, count in pairs(playerCount[luckyPlayer]) do
            table.insert(playerRecords, mut .. ": " .. count)
        end
        local playerRecordsText = table.concat(playerRecords, " | ")

        description = "**" .. cleanerText .. "**\n\n**Script Runtime:** " .. runtime ..
            "\n\n" .. playerStats ..
            "\n\n**Player Records**\n" .. playerRecordsText

        color = mutationColors[mutationName] or 8421504
    end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["content"] = content,
            ["embeds"] = {{
                ["description"] = description,
                ["color"] = color,
                ["footer"] = {["text"] = "Server Mybubub • " .. os.date("%X", os.time() - 3600)}
            }}
        })
    })
end

