-- [[ FUNGSI KIRIM WEBHOOK ]] --
local function sendWebhook(textMessage, isStart)
    local req = request or http_request or (http and http.request)
    if not req then return end

    local content
    
    if isStart then
        content = "🔔 **Webhook Roll Enchant Fishit Aktif!**\nScript running di akun: **" .. game.Players.LocalPlayer.Name .. "**"
    else
        -- Bersihkan tag formatting UI Roblox
        local cleanerText = textMessage:gsub("<[^>]*>", "")
        cleanerText = cleanerText:gsub("^%[Server%]:%s*", "")
        
        content = cleanerText
    end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["content"] = content
        })
    })
end

-- [[ STARTUP ]] --
sendWebhook(nil, true)

-- [[ FUNGSI EVALUASI TEMA PESAN ]] --
local function processChatMessage(msgText)
    local lowerMsg = msgText:lower()
    
    -- Tangkap pesan jika mengandung kata kunci roll atau enchant
    if lowerMsg:find("rolled") or lowerMsg:find("enchant") then
        sendWebhook(msgText, false)
    end
end

-- [[ DETEKSI VIA TEXTCHATSERVICE (SISTEM BARU) ]] --
local TextChatService = game:GetService("TextChatService")
if TextChatService then
    TextChatService.MessageReceived:Connect(function(message)
        if message and message.Text then
            processChatMessage(message.Text)
        end
    end)
end

-- [[ DETEKSI VIA PLAYERS CHATTED (FALLBACK SISTEM LAMA) ]] --
local Players = game:GetService("Players")
Players.PlayerAdded:Connect(function(player)
    player.Chatted:Connect(function(msg)
        processChatMessage(msg)
    end)
end)

for _, player in ipairs(Players:GetPlayers()) do
    player.Chatted:Connect(function(msg)
        processChatMessage(msg)
    end)
end
