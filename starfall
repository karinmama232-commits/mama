-- [[ CHAT MONITORING & CLAIM SYSTEM ]] --
local TextChatService = game:GetService("TextChatService")
local channel = TextChatService:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:FindFirstChild("RBXGeneral")

if channel then
    channel.MessageReceived:Connect(function(message)
        local rawText = message.Text
        local txt = rawText:lower()
        local senderName = message.TextSource and game.Players:GetPlayerByUserId(message.TextSource.UserId) and game.Players:GetPlayerByUserId(message.TextSource.UserId).Name or "Unknown Player"

        -- 1. DETECT !CLAIM COMMAND
        if txt:find("!claim") then
            local claimedTotal = totalCatches.total
            
            -- Send Green Notification Webhook
            sendWebhookPayload(
                "Fish Claimed Successfully!",
                "All accumulated target fish have been claimed by **" .. senderName .. "**!\n" ..
                "Total Claimed: **" .. claimedTotal .. " Fish**",
                65280, -- Green
                "Counter has been reset to 0"
            )

            -- Reset Accumulated Totals
            totalCatches.total = 0
            totalCatches.players = {}
            return
        end

        -- 2. DETECT FISH CATCH LOGS
        if txt:find("obtained") then
            local cleanerText = rawText:gsub("<[^>]*>", "")
            local luckyPlayer = cleanerText:match("^(.-) obtained") or "Unknown Player"
            
            for _, item in ipairs(targetItems) do
                if txt:find(item.name:lower()) then
                    -- Add to Hourly Buffer
                    local buf = catchBuffer[item.category]
                    buf.count = buf.count + 1
                    table.insert(buf.players, luckyPlayer)

                    -- Add to Lifetime Total
                    totalCatches.total = totalCatches.total + 1
                    
                    if not totalCatches.players[luckyPlayer] then
                        totalCatches.players[luckyPlayer] = { total = 0, items = {} }
                    end
                    
                    local pData = totalCatches.players[luckyPlayer]
                    pData.total = pData.total + 1
                    pData.items[item.shortName] = (pData.items[item.shortName] or 0) + 1
                    break
                end
            end
        end
    end)
end

-- [[ MAIN LOOP SCHEDULE ]] --
task.spawn(function()
    while true do
        local dateTable = os.date("*t", os.time())
        local hour = dateTable.hour
        local min = dateTable.min

        -- Trigger Recap on Minute 00 of Target Hours
        if targetEndHours[hour] and min == 0 then
            if not hasSentForCurrentHour then
                sendEventSummary()
                hasSentForCurrentHour = true
            end
        else
            hasSentForCurrentHour = false
        end

        task.wait(10)
    end
end)
