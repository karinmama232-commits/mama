local function getElementalZonesFolder()
    local worldSetup = workspace:FindFirstChild("WorldSetup")
    if not worldSetup then return nil end
    local elementalIsland = worldSetup:FindFirstChild("Elemental Island")
    if not elementalIsland then return nil end
    return elementalIsland:FindFirstChild("Zones")
end

-- Deteksi Ketat: Memastikan objek event benar-benar ada dan berisi (bukan folder kosong/palsu)
local function getActiveElementalEvent()
    local zones = getElementalZonesFolder()
    if not zones then return nil, nil end

    for eventName, _ in pairs(EVENT_LOCATIONS) do
        local shortName = eventName:gsub(" Elemental Event", "")
        local eventObj = zones:FindFirstChild(shortName) or zones:FindFirstChild(eventName)
        
        -- Validasi tambahan: Pastikan objek benar-benar eksis dan memiliki anak/komponen aktif di dalamnya
        if eventObj and (#eventObj:GetChildren() > 0 or eventObj:IsA("BasePart")) then
            return eventName, eventObj
        end
    end
    return nil, nil
end

local function teleportToEventRandom(eventName)
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if hrp and EVENT_LOCATIONS[eventName] then
        local cframes = EVENT_LOCATIONS[eventName]
        -- Pilih secara acak dari 3 titik koordinat yang tersedia agar tidak numpuk antar akun
        hrp.CFrame = cframes[math.random(1, #cframes)]
    end
end

