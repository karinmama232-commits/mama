-- Cosmic (Pengganti Auto Sell) - Loop 2 Jam 1 Menit
BtnCosmic.MouseButton1Click:Connect(function()
    isCosmic = not isCosmic
    BtnCosmic.BackgroundTransparency = isCosmic and 0 or 0.4
    if isCosmic then
        task.spawn(function()
            local RE_Cosmic = Net:WaitForChild("RE/c0fc304a1259f86803814ac63ad59a52c2e3dd150cdaf322b384e089798b2c9e")
            
            while isCosmic do
                -- 1. Pause mancing jika sedang aktif
                local wasFishingActive = isFishing
                if wasFishingActive then
                    isFishingPaused = true
                    task.wait(3)
                end

                -- 2. Unequip rod
                unequipRod()
                task.wait(2)

                -- 3. Pegang Star Fragment
                equipStarFragment()
                task.wait(2)

                -- 4. Trigger awal Cosmic (Azorath 1, 1)
                pcall(function()
                    RE_Cosmic:FireServer("Azorath", 1, 1)
                end)
                task.wait(2)

                -- 5. Spam trigger kedua (Azorath 1, 2) - 10x dalam 5 detik
                local startTime = tick()
                while tick() - startTime < 5 do
                    pcall(function()
                        RE_Cosmic:FireServer("Azorath", 1, 2)
                    end)
                    task.wait(0.5)
                end
                task.wait(2)

                -- 6. Un-equip / Tutup Star Fragment
                unequipRod()
                task.wait(2)

                -- 7. Pegang pancing kembali
                equipRod()
                task.wait(2)

                -- 8. Resume mancing
                if wasFishingActive and isFishing then
                    task.wait(3)
                    isFishingPaused = false
                end

                -- Loop 2 Jam 1 Menit (7260 Detik)
                for i = 7260, 1, -1 do
                    if not isCosmic then break end
                    task.wait(1)
                end
            end
        end)
    end
end)

