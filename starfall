-- [[ FUNGSI KIRIM WEBHOOK ]] --
local function sendWebhook(itemData, fullText, isStart)
    local req = request or http_request or (http and http.request)
    if not req then return end

    local content, description, color
    
    if isStart then
        content = "🔔 **Webhook Fishit Aktif!**"
        description = "Script running di akun: **" .. game.Players.LocalPlayer.Name .. "**\nMenunggu kabar dari server..."
        color = 65535 
    else
        local cleanerText = fullText:gsub("<[^>]*>", "") 
        local luckyPlayer = cleanerText:match("^(.-) obtained") or "Unknown Player"
        local category = itemData.category

        -- Update Counter Server
        serverCount[category] = (serverCount[category] or 0) + 1

        -- Update Counter Player
        playerCount[luckyPlayer] = playerCount[luckyPlayer] or {
            blizzard = 0, storm = 0, volcano = 0
        }
        playerCount[luckyPlayer][category] = playerCount[luckyPlayer][category] + 1

        local s = os.time() - startTime
        local runtime = string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)
        
        local fishFullWithWeight = cleanerText:match("obtained a (.-) with") or itemData.displayName

        content = "Congratulations!! **" .. luckyPlayer .. "** You have obtained a new **" .. fishFullWithWeight .. "** Fish!"
        
        local pStats = playerCount[luckyPlayer][category]
        local playerStats = "Player " .. luckyPlayer .. "\nSudah Menangkap " .. pStats .. " " .. itemData.displayName .. " (Lokasi: " .. itemData.location .. ")"

        local serverStats = "\nBlizzard (Mammofin): " .. serverCount.blizzard ..
                            "\nStorm (Stormshell): " .. serverCount.storm ..
                            "\nVolcano (Pyrocoil): " .. serverCount.volcano

        description = "**" .. cleanerText .. "**\n\n**Script Runtime:** " .. runtime ..
            "\n\n" .. playerStats ..
            "\n\n**Server Records**" .. serverStats
        
        color = itemData.color
    end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["content"] = content,
            ["embeds"] = {{
                ["description"] = description,
                ["color"] = color,
                ["footer"] = {["text"] = "Server Mybubub • " .. os.date("%X", os.time() - 3600)}
            }}
        })
    })
end

-- [[ STARTUP ]] --
