-- [[ FUNGSI DETEKSI EVENT UI DEPAN LAYAR ]] --
local function detectActiveEvent()
    local playerGui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return nil end

    for _, gui in pairs(playerGui:GetDescendants()) do
        if gui:IsA("TextLabel") or gui:IsA("TextButton") then
            local txt = gui.Text
            if txt and txt ~= "" then
                if txt:find("Blizzard Elemental Event") then
                    return "blizzard"
                elseif txt:find("Storm Elemental Event") then
                    return "storm"
                elseif txt:find("Volcano Elemental Event") then
                    return "volcano"
                end
            end
        end
    end
    return nil
end

-- [[ FUNGSI UTAMA KIRIM WEBHOOK ]] --
local function sendWebhook(options)
    local req = request or http_request or (http and http.request)
    if not req then return end

    local content = options.content or ""
    local description = options.description or ""
    local color = options.color or 8421504

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["content"] = content,
            ["embeds"] = {{
                ["description"] = description,
                ["color"] = color,
                ["footer"] = {["text"] = "Server Mybubub - " .. os.date("%X")}
            }}
        })
    })
end

-- [[ LOGIKA NOTIFIKASI EVENT START ]] --
local function handleEventStart()
    sessionServerCount = { blizzard = 0, storm = 0, volcano = 0 }
    sessionPlayerCount = {}
    eventStartTime = os.time()

    local detected = detectActiveEvent()
    currentEvent = detected

    local content, description, color

    if detected and eventData[detected] then
        local info = eventData[detected]
        content = info.Name .. " HAS STARTED"
        description = "Event Name: " .. info.Name .. "\n" ..
                      "Description: " .. info.Description .. "\n\n" ..
                      "Status: Event telah dimulai\n" ..
                      "Account: " .. game.Players.LocalPlayer.Name .. "\n" ..
                      "Silakan periksa area event."
        color = info.Color
    else
        content = "Elemental Event Started"
        description = "Event Name: Unknown Elemental Event\n" ..
                      "Description: Status event tidak terdeteksi di UI, namun jam event telah masuk.\n\n" ..
                      "Status: Event telah dimulai\n" ..
                      "Account: " .. game.Players.LocalPlayer.Name .. "\n" ..
                      "Silakan cek langsung ke lokasi event."
        color = 16744192
    end

    sendWebhook({
        content = content,
        description = description,
        color = color
    })
end

-- [[ LOGIKA NOTIFIKASI EVENT END & REKAP ]] --
local function handleEventEnd()
    local s = os.time() - startTime
    local totalRuntime = string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)

    local sessionPlayerDetails = ""
    local hasSessionData = false
    for player, stats in pairs(sessionPlayerCount) do
        local pItems = {}
        if stats.blizzard > 0 then table.insert(pItems, "Wintertusk Mammofin: " .. stats.blizzard) end
        if stats.storm > 0 then table.insert(pItems, "Stormshell Brute: " .. stats.storm) end
        if stats.volcano > 0 then table.insert(pItems, "Pyrocoil: " .. stats.volcano) end

        if #pItems > 0 then
            hasSessionData = true
            sessionPlayerDetails = sessionPlayerDetails .. "\n- " .. player .. ": " .. table.concat(pItems, " | ")
        end
    end

    if not hasSessionData then
        sessionPlayerDetails = "\nTidak ada player yang menangkap item event pada sesi ini."
    end

    local globalPlayerDetails = ""
    local hasGlobalData = false
    for player, stats in pairs(globalPlayerCount) do
        local pItems = {}
        if stats.blizzard > 0 then table.insert(pItems, "Wintertusk Mammofin: " .. stats.blizzard) end
        if stats.storm > 0 then table.insert(pItems, "Stormshell Brute: " .. stats.storm) end
        if stats.volcano > 0 then table.insert(pItems, "Pyrocoil: " .. stats.volcano) end

        if #pItems > 0 then
            hasGlobalData = true
            globalPlayerDetails = globalPlayerDetails .. "\n- " .. player .. ": " .. table.concat(pItems, " | ")
        end
    end

    if not hasGlobalData then
        globalPlayerDetails = "\nBelum ada player yang menangkap item event sejak script di-run."
    end

    local description = "Elemental Event Ended\n\n" ..
        "RINCIAN TANGKAPAN SESI INI:" .. sessionPlayerDetails .. "\n\n" ..
        "TOTAL REKAP SESI INI:\n" ..
        "Blizzard: " .. sessionServerCount.blizzard .. " | Storm: " .. sessionServerCount.storm .. " | Volcano: " .. sessionServerCount.volcano .. "\n\n" ..
        "----------------------------------------\n\n" ..
        "RINCIAN PLAYER KESELURUHAN (TOTAL RUN):" .. globalPlayerDetails .. "\n\n" ..
        "TOTAL AKUMULASI SERVER (TOTAL RUN):\n" ..
        "Blizzard: " .. globalServerCount.blizzard .. " | Storm: " .. globalServerCount.storm .. " | Volcano: " .. globalServerCount.volcano .. "\n\n" ..
        "Script Runtime: " .. totalRuntime

    sendWebhook({
        content = "Elemental Event Has Ended",
        description = description,
        color = 7632781
    })

    currentEvent = nil
end

-- [[ LOGIKA NOTIFIKASI ITEM CAUGHT (CHAT DETECTOR) ]] --
local function handleItemCaught(category, rawText)
    local cleanerText = rawText:gsub("<[^>]*>", "")
    local luckyPlayer = cleanerText:match("^(.-) obtained") or "Unknown Player"

    sessionServerCount[category] = (sessionServerCount[category] or 0) + 1
    sessionPlayerCount[luckyPlayer] = sessionPlayerCount[luckyPlayer] or { blizzard = 0, storm = 0, volcano = 0 }
    sessionPlayerCount[luckyPlayer][category] = sessionPlayerCount[luckyPlayer][category] + 1

    globalServerCount[category] = (globalServerCount[category] or 0) + 1
    globalPlayerCount[luckyPlayer] = globalPlayerCount[luckyPlayer] or { blizzard = 0, storm = 0, volcano = 0 }
    globalPlayerCount[luckyPlayer][category] = globalPlayerCount[luckyPlayer][category] + 1

    local s = os.time() - startTime
    local runtime = string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)

    local info = eventData[category]
    local fishFullWithWeight = cleanerText:match("obtained a (.-) with") or info.Fish

    local content = luckyPlayer .. " obtained a new " .. fishFullWithWeight .. " Fish"

    local playerStats = "Player " .. luckyPlayer .. "\nSudah Menangkap " .. sessionPlayerCount[luckyPlayer][category] .. " " .. info.Fish

    local serverStats = "\nBlizzard: " .. sessionServerCount.blizzard ..
                        " | Storm: " .. sessionServerCount.storm ..
                        " | Volcano: " .. sessionServerCount.volcano

    local description = info.Name .. "\n" ..
                        info.Description .. "\n\n" ..
                        cleanerText .. "\n\n" ..
                        "Script Runtime: " .. runtime .. "\n\n" ..
                        playerStats .. "\n\n" ..
                        "Sesi Event Records" .. serverStats

    sendWebhook({
        content = content,
        description = description,
        color = info.Color
    })
end

