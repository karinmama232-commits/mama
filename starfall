-- [[ SCHEDULE LOOP ]] --
task.spawn(function()
    local startHours = {[23]=true, [2]=true, [5]=true, [8]=true, [11]=true, [14]=true, [17]=true, [20]=true}
    local endHours   = {[0]=true, [3]=true, [6]=true, [9]=true, [12]=true, [15]=true, [18]=true, [21]=true, [24]=true}

    local hasTriggeredStart = false
    local hasTriggeredEnd   = false

    while true do
        local t = os.date("*t")
        local hour = t.hour
        local min  = t.min
        local sec  = t.sec

        if startHours[hour] and min == 0 and sec == 5 then
            if not hasTriggeredStart then
                handleEventStart()
                hasTriggeredStart = true
            end
        else
            hasTriggeredStart = false
        end

        if endHours[hour] and min == 0 and sec == 5 then
            if not hasTriggeredEnd then
                handleEventEnd()
                hasTriggeredEnd = true
            end
        else
            hasTriggeredEnd = false
        end

        task.wait(0.5)
    end
end)

-- [[ CHAT DETECTOR LISTENER ]] --
local TextChatService = game:GetService("TextChatService")
local channel = TextChatService:FindFirstChild("RBXGeneral") or TextChatService.TextChannels:FindFirstChild("RBXGeneral")

if channel then
    channel.MessageReceived:Connect(function(message)
        local txt = message.Text:lower()

        if txt:find("obtained") then
            for _, n in pairs(list_blizzard) do
                if txt:find(n:lower()) then
                    handleItemCaught("blizzard", message.Text)
                    return
                end
            end
            for _, n in pairs(list_storm) do
                if txt:find(n:lower()) then
                    handleItemCaught("storm", message.Text)
                    return
                end
            end
            for _, n in pairs(list_volcano) do
                if txt:find(n:lower()) then
                    handleItemCaught("volcano", message.Text)
                    return
                end
            end
        end
    end)
end
