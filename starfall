-- ==========================================
-- 4. LOGIKA AUTO TELEPORT JAM KHUSUS
-- ==========================================
task.spawn(function()
    local targetHours = {[3]=true, [6]=true, [9]=true, [12]=true, [15]=true, [18]=true, [21]=true, [0]=true, [24]=true}
    local hasTeleportedThisSecond = false

    while true do
        if isAutoEventRunning then
            local t = os.date("*t")
            local hour = t.hour
            local minute = t.min
            local second = t.sec

            -- Mengecek jam 3, 6, 9, 12, 15, 18, 21, 24(00) tepat pada menit 00 dan detik 05
            if targetHours[hour] and minute == 0 and second == 5 then
                if not hasTeleportedThisSecond then
                    teleportRandom()
                    hasTeleportedThisSecond = true
                end
            else
                hasTeleportedThisSecond = false
            end
        end
        task.wait(0.5)
    end
end)
