-- Variables State Auto Event
local eventsFolder = ReplicatedStorage:WaitForChild("Events", 10)
local savedPosition = nil
local activeEventName = nil
local isAutoEventEnabled = false

local function getRoot()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart", 5)
end

local function checkAndTeleport()
    if not isAutoEventEnabled then return end
    if not eventsFolder then return end
    
    local foundEvent = nil
    for _, child in ipairs(eventsFolder:GetChildren()) do
        if eventLocations[child.Name] then
            foundEvent = child.Name
            break
        end
    end
    
    -- Jika ada Event Aktif dan belum teleport
    if foundEvent and not activeEventName then
        local root = getRoot()
        if root then
            savedPosition = root.CFrame
            activeEventName = foundEvent
            
            -- Pilih 1 CFrame secara acak dari 3 lokasi event tersebut
            local coords = eventLocations[foundEvent]
            local randomCFrame = coords[math.random(1, #coords)]
            
            root.CFrame = randomCFrame
        end
        
    -- Jika Event Selesai / Hilang
    elseif not foundEvent and activeEventName then
        local root = getRoot()
        if root and savedPosition then
            root.CFrame = savedPosition
        end
        savedPosition = nil
        activeEventName = nil
    end
end

