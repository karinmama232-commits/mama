local startTime = os.time()

-- Window Jam Selesai Event Asli (03:00, 06:00, 09:00, 12:00, 15:00, 18:00, 21:00, 00:00)
local targetEndHours = {[3] = true, [6] = true, [9] = true, [12] = true, [15] = true, [18] = true, [21] = true, [0] = true}

-- Target Items & Data Mapping
local targetItems = {
    { 
        name = "Wintertusk Mammofin", 
