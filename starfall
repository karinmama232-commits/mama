local function secureClick()
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local char = Player.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local dist = (char.HumanoidRootPart.Position - obj.Parent.Position).Magnitude
                    if dist < 25 then
                        task.wait(0.2)
                        fireproximityprompt(obj)
                    end
                end
            end
        end
    end)
end

-- Helper: Eksekusi berulang selama 'duration' detik (mencegah terlewat karena lag)
local function repeatActionForDuration(duration, actionFunc)
    local startTime = tick()
    while tick() - startTime < duration do
        pcall(actionFunc)
        task.wait(0.1)
    end
end

-- Remote Actions Baru
local function equipRod()
    repeatActionForDuration(2, function()
        local RE_Equip = Net:WaitForChild("RE/8bcc943fdd2a5c5d99f3d4f4e0f5ff1066f256a8b0e96cb5e919c897885d3895")
        RE_Equip:FireServer(1)
    end)
end

