-- [[ HELPER FUNCTIONS ]] --
local function getFormattedRuntime()
    local s = os.time() - startTime
    return string.format("%02d:%02d:%02d", math.floor(s / 3600), math.floor((s % 3600) / 60), s % 60)
end

local function sendWebhookPayload(embedTitle, descriptionText, embedColor)
    local req = request or http_request or (http and http.request)
    if not req then return end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["embeds"] = {{
                ["title"] = embedTitle,
                ["description"] = descriptionText,
                ["color"] = embedColor,
                ["footer"] = {
                    ["text"] = "Script Runtime: " .. getFormattedRuntime()
                }
            }}
        })
    })
end

-- [[ FUNGSI KIRIM REKAP EVENT ]] --
local function sendEventSummary()
    local currentTimeTable = os.date("*t", os.time())
    local currentHour = currentTimeTable.hour
    
    -- Hitung Waktu Session (Dikurangi 1 Jam untuk Tampilan Text)
    local startHour = (currentHour - 1) % 24
    local timeSessionStr = string.format("%02d:00 - %02d:00, %s", startHour, currentHour, os.date("%d %B %Y", os.time()))

    -- Cari apakah ada ikan yang berhasil ditangkap selama window ini
    local activeItem = nil
    local catchCount = 0

    for _, item in ipairs(targetItems) do
        local count = catchBuffer[item.category] or 0
        if count > 0 then
            activeItem = item
            catchCount = count
            break
        end
    end

    local title, description, color

    if activeItem and catchCount > 0 then
        -- KONDISI 1: ADA IKAN TERTANGKAP
        title = activeItem.eventTitle
        description = "**Event Session:** " .. timeSessionStr .. "\n\n" ..
                      "**In Server**\n" ..
                      "Sudah Menangkap " .. catchCount .. " " .. activeItem.displayName .. " (Lokasi: " .. activeItem.location .. ")"
        color = activeItem.color
    else
        -- KONDISI 2: ZERO CATCH (TIDAK ADA IKAN)
        title = "Elemental Event Has Concluded!"
        description = "**Event Session:** " .. timeSessionStr .. "\n\n" ..
                      "Tidak ada ikan yang di dapat"
        color = 0 -- Warna Hitam
    end

    -- Kirim Webhook
    sendWebhookPayload(title, description, color)

    -- Reset Buffer untuk Window Event Berikutnya
    for k in pairs(catchBuffer) do
        catchBuffer[k] = 0
    end
end

