-- ==========================================
-- 5. LOGIKA ANCHOR TIME PERBAIKAN (UTC TO WIB)
-- ==========================================
local EVENTS_LIST = {"Blizzard", "Storm", "Volcano"}
local EVENT_SLOTS = {1, 4, 7, 10, 13, 16, 19, 22} -- 8 Event per hari (Interval 3 Jam)

-- Fungsi mengonversi os.time() UTC ke WIB (+7 Jam)
local function getWIBTime()
    return os.time() + (7 * 3600)
end

local function getEventInfoAt(wibTimestamp)
    local tData = os.date("!*t", wibTimestamp)
    local startOfDay = os.time({year=tData.year, month=tData.month, day=tData.day, hour=0, min=0, sec=0})
    
    local currentTotalSec = (tData.hour * 3600) + (tData.min * 60) + tData.sec

    -- Anchor: 27 Agustus 2026 Jam 16:00 WIB (Storm)
    -- Jam 16:00 WIB ada di index slot ke-6 (16 / 3 + 1 = 6)
    local anchorDayStart = os.time({year=2026, month=8, day=27, hour=0, min=0, sec=0})
    local daysDiff = math.floor((startOfDay - anchorDayStart) / 86400)

    local activeEvent = nil
    local targetSecTimestamp = 0

    for i, slotHour in ipairs(EVENT_SLOTS) do
        local slotStartSec = slotHour * 3600
        local slotEndSec = (slotHour + 1) * 3600 -- Event berlangsung 1 jam

        if currentTotalSec >= slotStartSec and currentTotalSec < slotEndSec then
            local totalSlotShift = (daysDiff * #EVENT_SLOTS) + (i - 6)
            local eventIdx = ((1 + totalSlotShift) % #EVENTS_LIST) + 1
            activeEvent = EVENTS_LIST[eventIdx]
            targetSecTimestamp = startOfDay + slotEndSec
            break
        end
    end

    return activeEvent, targetSecTimestamp
end

task.spawn(function()
    while true do
        local wibNow = getWIBTime()
        local activeEvent, targetTimestamp = getEventInfoAt(wibNow)

        if activeEvent then
            -- === EVENT ACTIVE ===
            local diffSec = targetTimestamp - wibNow
            if diffSec < 0 then diffSec = 0 end

            local remHrs = math.floor(diffSec / 3600)
            local remMin = math.floor((diffSec % 3600) / 60)
            local remSec = diffSec % 60
            local timeStr = string.format("%02d:%02d:%02d", remHrs, remMin, remSec)

            if isAutoEventRunning then
                if currentActiveEvent ~= activeEvent then
                    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        if not savedPosition then
                            savedPosition = hrp.CFrame
                        end
                        teleportRandom(activeEvent)
                    end
                    currentActiveEvent = activeEvent
                end
            end

            InfoLabel.Text = string.format("⚡ EVENT ACTIVE ⚡\n%s Event\nSisa Waktu: %s", activeEvent:upper(), timeStr)
            InfoLabel.TextColor3 = Color3.fromRGB(180, 40, 40)

        else
            -- === WAITING / COOLDOWN ===
            if isAutoEventRunning and savedPosition then
                local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = savedPosition
                end
                savedPosition = nil
                currentActiveEvent = nil
            end

            local tData = os.date("!*t", wibNow)
            local startOfDay = os.time({year=tData.year, month=tData.month, day=tData.day, hour=0, min=0, sec=0})
            local currentTotalSec = (tData.hour * 3600) + (tData.min * 60) + tData.sec

            local nextEventSec = nil
            local nextEvNameFound = "Blizzard"
            local anchorDayStart = os.time({year=2026, month=8, day=27, hour=0, min=0, sec=0})

            for i, slotHour in ipairs(EVENT_SLOTS) do
                local slotStartSec = slotHour * 3600
                if slotStartSec > currentTotalSec then
                    nextEventSec = startOfDay + slotStartSec
                    local daysDiff = math.floor((startOfDay - anchorDayStart) / 86400)
                    local totalSlotShift = (daysDiff * #EVENT_SLOTS) + (i - 6)
                    local eventIdx = ((1 + totalSlotShift) % #EVENTS_LIST) + 1
                    nextEvNameFound = EVENTS_LIST[eventIdx]
                    break
                end
            end

            if not nextEventSec then
                local nextDayStart = startOfDay + 86400
                nextEventSec = nextDayStart + (EVENT_SLOTS[1] * 3600)
                local daysDiff = math.floor((nextDayStart - anchorDayStart) / 86400)
                local totalSlotShift = (daysDiff * #EVENT_SLOTS) + (1 - 6)
                local eventIdx = ((1 + totalSlotShift) % #EVENTS_LIST) + 1
                nextEvNameFound = EVENTS_LIST[eventIdx]
            end

            local diffSec = nextEventSec - wibNow
            if diffSec < 0 then diffSec = 0 end

            local remHrs = math.floor(diffSec / 3600)
            local remMin = math.floor((diffSec % 3600) / 60)
            local remSec = diffSec % 60
            local timeStr = string.format("%02d:%02d:%02d", remHrs, remMin, remSec)

            InfoLabel.Text = string.format("⏳ WAITING EVENT ⏳\nNext: %s Event\nCooldown: %s", nextEvNameFound, timeStr)
            InfoLabel.TextColor3 = Color3.fromRGB(30, 80, 150)
        end

        task.wait(1)
    end
end)
