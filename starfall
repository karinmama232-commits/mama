-- Main Loop Pengecekan per Detik
task.spawn(function()
    while true do
        -- Hitung Sisa Waktu Global (Berbasis durasi 1 jam, reset di menit :00)
        local currentTime = os.time()
        local currentMinute = tonumber(os.date("%M", currentTime))
        local currentSecond = tonumber(os.date("%S", currentTime))
        
        local remainingSeconds = ((59 - currentMinute) * 60) + (60 - currentSecond)
        local minutesLeft = math.floor(remainingSeconds / 60)
        local secondsLeft = remainingSeconds % 60
        local timeString = string.format("%02d:%02d", minutesLeft, secondsLeft)

        -- Cek Event Aktif secara Real-Time Tiap Detik dengan Validasi Ketat
        local eventName, eventObj = getActiveElementalEvent()
        
        if eventName then
            local cleanName = eventName:gsub(" Elemental Event", "")
            InfoLabel.Text = "Event Aktif: " .. cleanName .. "\nSisa Waktu: " .. timeString
            
            -- Logika Auto Teleport Random SEKALI SAJA saat event baru terdeteksi aktif
            if isAutoEventRunning then
                if lastTeleportedEvent ~= eventName then
                    teleportToEventRandom(eventName)
                    lastTeleportedEvent = eventName -- Kunci agar tidak teleport ulang di event yang sama
                end
            end
        else
            InfoLabel.Text = "Event Aktif: Tidak Ada\nSisa Waktu: " .. timeString
            -- Jika event sudah hilang / selesai di server, reset pengunci
            lastTeleportedEvent = nil
        end

        task.wait(1) -- Cek terus secara stabil setiap 1 detik
    end
end)
