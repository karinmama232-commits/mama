-- Memory Buffer (Counter & List Player per Kategori)
local catchBuffer = {
    blizzard = { count = 0, players = {} },
    storm    = { count = 0, players = {} },
    volcano  = { count = 0, players = {} }
}

local hasSentForCurrentHour = false

-- [[ HELPER FUNCTIONS ]] --
local function getFormattedRuntime()
    local s = os.time() - startTime
    return string.format("%02d:%02d:%02d", math.floor(s / 3600), math.floor((s % 3600) / 60), s % 60)
end

local function sendWebhookPayload(embedTitle, descriptionText, embedColor, footerText)
    local req = request or http_request or (http and http.request)
    if not req then return end

    req({
        Url = webhook_url,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = game:GetService("HttpService"):JSONEncode({
            ["embeds"] = {{
                ["title"] = embedTitle,
                ["description"] = descriptionText,
                ["color"] = embedColor,
                ["footer"] = {
                    ["text"] = footerText
                }
            }}
        })
    })
end

-- [[ FUNGSI KIRIM REKAP EVENT ]] --
local function sendEventSummary()
    local currentTimeTable = os.date("*t", os.time())
    local currentHour = currentTimeTable.hour
    
    -- Display Waktu di Discord Dikurangi 1 Jam
    local endHourDisplay = (currentHour - 1) % 24
    local startHourDisplay = (endHourDisplay - 1) % 24
    local timeSessionStr = string.format("%02d:00 - %02d:00, %s", startHourDisplay, endHourDisplay, os.date("%d %B %Y", os.time()))
    local footerStr = "Event Session: " .. timeSessionStr .. " • Script Runtime: " .. getFormattedRuntime()

    -- Cek item yang tertangkap
    local activeItem = nil
    local itemData = nil

    for _, item in ipairs(targetItems) do
        local buf = catchBuffer[item.category]
        if buf and buf.count > 0 then
            activeItem = item
            itemData = buf
            break
        end
    end

    local title, description, color

    if activeItem and itemData then
        -- KONDISI 1: ADA IKAN TERTANGKAP (Dengan Enter / Baris Baru untuk List Player)
        title = activeItem.eventTitle
        local playerListStr = table.concat(itemData.players, ", ")
        
        description = "**Location: " .. activeItem.location .. "**\n" ..
                      "Caught " .. itemData.count .. " " .. activeItem.displayName .. "\n" ..
                      "(" .. playerListStr .. ")"
        color = activeItem.color
    else
        -- KONDISI 2: ZERO CATCH (TIDAK ADA IKAN)
        title = "Elemental Event Has Concluded!"
        description = "No target fish caught during this event."
        color = 0 -- Warna Hitam
    end

    -- Kirim Webhook
    sendWebhookPayload(title, description, color, footerStr)

    -- Reset Buffer
    for k in pairs(catchBuffer) do
        catchBuffer[k] = { count = 0, players = {} }
    end
end

-- [[ STARTUP NOTIFICATION ]] --
