-- Daftar item untuk deteksi & mapping lokasi/kategori
local targetItems = {
    { name = "Wintertusk Mammofin", category = "blizzard", displayName = "Wintertusk Mammofin", location = "Blizzard", color = 38399 },  -- Biru Muda (#00C6FF -> 38399)
    { name = "Stormshell Brute",   category = "storm",    displayName = "Stormshell Brute",   location = "Storm",    color = 16766720 }, -- Gold (#FFD700 -> 16766720)
