-- Fungsi Alur Rute Map Utama
local function executeMapRoutine(map, loopType)
    respawnCharacter()
    
    while true do
        if (loopType == "map" and activeMapLoop ~= map.name) or (loopType == "auto" and not isAutoSpawnActive) or (loopType == "allmap" and not isAutoAllMapActive) then break end
        
        for _, ptCFrame in ipairs(map.points) do
            if (loopType == "map" and activeMapLoop ~= map.name) or (loopType == "auto" and not isAutoSpawnActive) or (loopType == "allmap" and not isAutoAllMapActive) then break end
            
            walkToTarget(startRunVector, loopType)
            task.wait(0.2)
            if (loopType == "map" and activeMapLoop ~= map.name) or (loopType == "auto" and not isAutoSpawnActive) or (loopType == "allmap" and not isAutoAllMapActive) then break end
            
            walkToTarget(ptCFrame.Position, loopType)
            task.wait(0.2)
            secureInteractForDuration(0.1, loopType)
            task.wait(0.1)
        end
        
        if savedLocation then
            walkToTarget(savedLocation.Position, loopType)
            task.wait(0.5)
        end
        
        local waitStartTime = tick()
        while tick() - waitStartTime < 150 do
            if (loopType == "map" and activeMapLoop ~= map.name) or (loopType == "auto" and not isAutoSpawnActive) or (loopType == "allmap" and not isAutoAllMapActive) then break end
            task.wait(1)
        end
        
        if (loopType == "map" and activeMapLoop ~= map.name) or (loopType == "auto" and not isAutoSpawnActive) or (loopType == "allmap" and not isAutoAllMapActive) then break end
        
        respawnCharacter()
        
        if loopType == "auto" or loopType == "allmap" then break end 
    end
end

-- Pembuatan 13 Tombol Map
local mapButtons = {}
local startY = 76
local btnWidth = 78
local btnHeight = 20
local spacing = 8

for i, map in ipairs(mapData) do
    local mapBtn = Instance.new("TextButton", MainFrame)
    mapBtn.Text = map.name:upper()
    styleBtn(mapBtn, 9)
    
    if i <= 12 then
        local col = (i - 1) % 3
        local row = math.floor((i - 1) / 3)
        mapBtn.Size = UDim2.new(0, btnWidth, 0, btnHeight)
        mapBtn.Position = UDim2.new(0, 10 + col * (btnWidth + spacing), 0, startY + row * (btnHeight + 4))
    else
        mapBtn.Size = UDim2.new(0, 250, 0, btnHeight)
        mapBtn.Position = UDim2.new(0, 10, 0, startY + 4 * (btnHeight + 4))
    end
    
    mapButtons[map.name] = mapBtn
    
    mapBtn.MouseButton1Click:Connect(function()
        local currentSpeed = 0
        pcall(function() currentSpeed = Player.leaderstats.Speed.Value end)
        
        if currentSpeed < map.reqSpeed then
            return 
        end
        
        if activeMapLoop == map.name then
            activeMapLoop = nil
            styleBtn(mapBtn, 9)
        else
            activeMapLoop = map.name
            for _, m in ipairs(mapData) do
                if mapButtons[m.name] then styleBtn(mapButtons[m.name], 9) end
            end
            mapBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
            mapBtn.BackgroundTransparency = 0
            
            task.spawn(function()
                executeMapRoutine(map, "map")
                styleBtn(mapBtn, 9)
            end)
        end
    end)
end

