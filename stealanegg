-- Real-time Checker: Update Speed Stats & Warna Tombol Map
RunService.RenderStepped:Connect(function()
    local currentSpeed = 0
    pcall(function()
        if Player:FindFirstChild("leaderstats") and Player.leaderstats:FindFirstChild("Speed") then
            currentSpeed = Player.leaderstats.Speed.Value
        end
    end)
    
    SpeedStatsLabel.Text = "Speed Stats: " .. tostring(currentSpeed)
    
    for _, map in ipairs(mapData) do
        local btn = mapButtons[map.name]
        if btn and activeMapLoop ~= map.name then
            if currentSpeed < map.reqSpeed then
                btn.BackgroundColor3 = Color3.fromRGB(192, 57, 43) -- Merah (Terkunci)
                btn.BackgroundTransparency = 0.3
            else
                if not activeMapLoop or activeMapLoop ~= map.name then
                    styleBtn(btn, 9)
                end
            end
        end
    end
end)

-- Sistem Deteksi Auto Spawn Dilengkapi Filter Cek Speed Pemain
local function triggerAutoSpawnCheck(rawText)
    if not isAutoSpawnActive then return end
    local textLower = rawText:lower()
    if textLower:find("spawned in") or textLower:find("egg") then
        local currentSpeed = 0
        pcall(function() currentSpeed = Player.leaderstats.Speed.Value end)
        
        for _, map in ipairs(mapData) do
            if textLower:find(map.name) then
                -- Cek apakah speed pemain sudah memenuhi syarat map tersebut
                if currentSpeed >= map.reqSpeed then
                    task.spawn(function()
                        executeMapRoutine(map, "auto")
                    end)
                end
                break
            end
        end
    end
end

