local function getPlayerSpeed()
    local success, val = pcall(function()
        local leaderstats = Player:FindFirstChild("leaderstats")
        if leaderstats then
            local speedStat = leaderstats:FindFirstChild("Speed")
            if speedStat then
                return speedStat.Value
            end
        end
        return 0
    end)
    return success and val or 0
end

local function walkToVector(targetVector)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if humanoid and hrp then
        humanoid:MoveTo(targetVector)
        local startTime = tick()
        while (hrp.Position - targetVector).Magnitude > 3 do
            if not isAuto13Active and not isAutoSpawnActive and not activeMapLoop then break end
            if tick() - startTime > 1 then
                humanoid:MoveTo(targetVector)
                startTime = tick()
            end
            task.wait(0.2)
        end
    end
end

local function secureInteractFast(duration)
    local startTime = tick()
    while tick() - startTime < duration do
        if not isAuto13Active and not isAutoSpawnActive and not activeMapLoop then break end
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    local char = Player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local dist = (char.HumanoidRootPart.Position - obj.Parent.Position).Magnitude
                        if dist < 25 then
                            fireproximityprompt(obj)
                        end
                    end
                end
            end
        end)
        task.wait(0.05)
    end
end

local function runMapRoutine(map, checkActiveFunc)
    for _, pointVector in ipairs(map.points) do
        if checkActiveFunc and not checkActiveFunc() then break end
        walkToVector(startRunVector)
        task.wait(0.1)
        if checkActiveFunc and not checkActiveFunc() then break end
        walkToVector(pointVector)
        task.wait(0.1)
        if checkActiveFunc and not checkActiveFunc() then break end
        secureInteractFast(0.33)
        task.wait(0.1)
    end
    if savedLocation then
        walkToVector(savedLocation.Position)
    end
end

