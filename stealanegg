local function saveCurrentLocation()
    local char = Player.Character or Player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then savedLocation = hrp.CFrame end
end

local function respawnCharacter()
    pcall(function()
        local char = Player.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.Health = 0
        end
    end)
    Player.CharacterAdded:Wait()
    task.wait(1.5)
end

local function walkToTarget(targetVector, loopCheckVar)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if humanoid and hrp then
        humanoid:MoveTo(targetVector)
        local startTime = tick()
        while (hrp.Position - targetVector).Magnitude > 3 do
            if (loopCheckVar == "map" and not activeMapLoop) or (loopCheckVar == "auto" and not isAutoSpawnActive) or (loopCheckVar == "allmap" and not isAutoAllMapActive) then break end
            if tick() - startTime > 1 then
                humanoid:MoveTo(targetVector)
                startTime = tick()
            end
            task.wait(0.2)
        end
    end
end

local function secureInteractForDuration(duration, loopCheckVar)
    local startTime = tick()
    while tick() - startTime < duration do
        if (loopCheckVar == "map" and not activeMapLoop) or (loopCheckVar == "auto" and not isAutoSpawnActive) or (loopCheckVar == "allmap" and not isAutoAllMapActive) then break end
        pcall(function()
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    local char = Player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local dist = (char.HumanoidRootPart.Position - obj.Parent.Position).Magnitude
                        if dist < 25 then
                            fireproximityprompt(obj)
                        end
                    end
                end
            end
        end)
        task.wait(0.1)
    end
end

