-- Logic Manual Map Buttons
for _, map in ipairs(mapData) do
    local btn = mapButtons[map.name]
    if btn then
        btn.MouseButton1Click:Connect(function()
            local currentSpeed = getPlayerSpeed()
            if currentSpeed < map.minVal then return end
            
            if activeMapLoop == map.name then
                activeMapLoop = nil
                btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                btn.BackgroundTransparency = 0.3
            else
                activeMapLoop = map.name
                for _, m in ipairs(mapData) do
                    if m.name ~= map.name and mapButtons[m.name] then
                        mapButtons[m.name].BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                        mapButtons[m.name].BackgroundTransparency = 0.3
                    end
                end
                btn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
                btn.BackgroundTransparency = 0
                
                task.spawn(function()
                    while activeMapLoop == map.name do
                        runMapRoutine(map, function() return activeMapLoop == map.name end)
                        task.wait(0.5)
                    end
                    btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                    btn.BackgroundTransparency = 0.3
                end)
            end
        end)
    end
end

