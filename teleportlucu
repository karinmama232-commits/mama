-- Fungsi auto teleport loncat-loncat
local function autoTeleport(targetPos, hopDist)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local currentPos = hrp.Position
    local direction = (targetPos - currentPos).Unit
    local distance = (targetPos - currentPos).Magnitude
    local traveled = 0

    hrp.CanCollide = false -- nembus bangunan

    -- speed multiplier dari TextBox
    local mult = tonumber(speedBox.Text:match("%d+")) or 4

    while traveled < distance do
        local moveDist = math.min(hopDist, distance - traveled)
        local nextPos = currentPos + direction * moveDist

        -- BodyVelocity biar ngambang
        local bv = Instance.new("BodyVelocity")
        bv.Velocity = Vector3.new(0,5,0)
        bv.MaxForce = Vector3.new(1e5,1e5,1e5)
        bv.Parent = hrp

        local tweenInfo = TweenInfo.new(
            1/mult, -- makin besar multiplier makin cepat
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        )
        local goal = {CFrame = CFrame.new(nextPos)}
        local tween = TweenService:Create(hrp, tweenInfo, goal)
        tween:Play()
        tween.Completed:Wait()

        traveled = traveled + moveDist
        currentPos = nextPos
        bv:Destroy()
    end

    hrp.CanCollide = true -- normal lagi
end

